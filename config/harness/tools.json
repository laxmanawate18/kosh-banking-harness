{
  "_about": "Kosh banking harness tool registry. Every tool an agent may call, per channel: what it does, whether it reads, writes or moves money, its risk, who must approve its effect (none, the customer in Kavach, or an officer), the OAuth scope it needs, and the arguments it accepts. The gate refuses any tool or argument not declared here.",
  "version": "2026-10-05.1",
  "channels": {
    "customer": {
      "check_funds": {
        "description": "Whether an account has enough available for an amount (yes or no; figures stay on the server)",
        "effect": "read",
        "risk": "low",
        "approval": "none",
        "scopes": [
          "banking.read"
        ],
        "args": {
          "amount_minor": {
            "type": "integer",
            "min": 1,
            "max": 100000000000,
            "required": true
          },
          "account_id": {
            "type": "string",
            "pattern": "^(?i:ACC-[A-Z0-9-]{1,40})$",
            "required": false
          }
        },
        "consent": "accounts:read",
        "model_view": {
          "fields": [
            "success",
            "error",
            "account_id",
            "account_name",
            "covers"
          ],
          "amounts": [
            "available_minor",
            "shortfall_minor"
          ]
        }
      },
      "summarise_spending": {
        "description": "Money in and out over recent days, by category (totals stay on the server)",
        "effect": "read",
        "risk": "low",
        "approval": "none",
        "scopes": [
          "banking.read"
        ],
        "args": {
          "days": {
            "type": "integer",
            "min": 1,
            "max": 365,
            "required": false
          },
          "category": {
            "type": "string",
            "max_length": 40,
            "required": false
          }
        },
        "consent": "accounts:read",
        "model_view": {
          "fields": [
            "success",
            "days",
            "category",
            "count",
            "categories"
          ],
          "amounts": [
            "spent_minor",
            "received_minor"
          ]
        }
      },
      "get_customer_summary": {
        "description": "Accounts, balances and payees of the signed-in customer",
        "effect": "read",
        "risk": "low",
        "approval": "none",
        "scopes": [
          "banking.read"
        ],
        "args": {},
        "consent": "accounts:read",
        "model_view": {
          "fields": [
            "customer.tier",
            "customer.kyc_status",
            "accounts[].id",
            "accounts[].name",
            "accounts[].type",
            "accounts[].status",
            "accounts[].currency",
            "accounts[].account_number_masked",
            "accounts[].is_primary",
            "beneficiaries[].id",
            "beneficiaries[].display_name",
            "beneficiaries[].destination_masked",
            "beneficiaries[].kind",
            "beneficiaries[].relationship",
            "beneficiaries[].availability",
            "currency"
          ],
          "amounts": [
            "accounts[].available_balance_minor",
            "accounts[].balance_minor",
            "total_available_minor"
          ]
        }
      },
      "get_transaction_history": {
        "description": "Recent transactions",
        "effect": "read",
        "risk": "low",
