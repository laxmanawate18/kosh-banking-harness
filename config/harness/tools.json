      "propose_bill_payment": {
        "description": "Propose paying a registered bill",
        "effect": "money",
        "risk": "high",
        "approval": "customer",
        "scopes": [
          "banking.propose"
        ],
        "args": {
          "bill_id": {
            "type": "string",
            "pattern": "^(?i:BILL-[A-Z0-9-]{1,40})$",
            "required": true
          },
          "source_account_id": {
            "type": "string",
            "pattern": "^(?i:ACC-[A-Z0-9-]{1,40})$",
            "required": true
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000000,
            "required": false
          }
        },
        "consent": "payments:propose",
        "model_view": {
          "fields": [
            "success",
            "status",
            "error",
            "challenge_id",
            "payment_intent_id",
            "sentinel.decision",
            "sentinel.customer_message",
            "challenge.payee_name",
            "challenge.destination_masked",
            "challenge.source_account_name",
            "challenge.source_account_masked",
            "challenge.expires_at",
            "receipt.reference",
            "receipt.payee_name",
            "receipt.source_account_masked",
            "receipt.status",
            "receipt.executed_at",
            "presentation.title"
          ],
          "amounts": [
            "challenge.amount_minor",
            "receipt.amount_minor",
            "receipt.remaining_balance_minor"
          ]
        }
      },
