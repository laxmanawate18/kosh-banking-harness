{
  "_about": "Kosh banking harness tool registry. Every tool an agent may call, per channel: what it does, whether it reads, writes or moves money, its risk, who must approve its effect (none, the customer in Kavach, or an officer), the OAuth scope it needs, and the arguments it accepts. The gate refuses any tool or argument not declared here.",
  "version": "2026-10-05.1",
  "channels": {
    "customer": {
      "get_customer_summary": {
        "description": "Accounts, balances and payees of the signed-in customer",
        "effect": "read",
        "risk": "low",
        "approval": "none",
        "scopes": [
          "banking.read"
        ],
        "args": {}
      },
      "get_transaction_history": {
        "description": "Recent transactions",
        "effect": "read",
        "risk": "low",
        "approval": "none",
        "scopes": [
          "banking.read"
        ],
        "args": {
          "account_id": {
            "type": "string",
            "pattern": "^(?i:ACC-[A-Z0-9-]{1,40})$",
            "required": false
          },
          "limit": {
            "type": "integer",
            "min": 1,
            "max": 50
          }
        }
      },
      "get_outstanding_bills": {
