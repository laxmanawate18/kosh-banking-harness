        "consent": "payments:propose",
        "model_view": {
          "fields": [
            "success",
            "status",
            "error",
            "challenge_id",
            "payment_intent_id",
            "sentinel.decision",
            "sentinel.customer_message",
            "challenge.payee_name",
            "challenge.destination_masked",
            "challenge.source_account_name",
            "challenge.source_account_masked",
            "challenge.expires_at",
            "receipt.reference",
            "receipt.payee_name",
            "receipt.source_account_masked",
            "receipt.status",
            "receipt.executed_at",
            "presentation.title"
          ],
          "amounts": [
            "challenge.amount_minor",
            "receipt.amount_minor",
            "receipt.remaining_balance_minor"
          ]
        }
