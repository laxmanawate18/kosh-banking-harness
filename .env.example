# Fast Local Replica (Instant < 1ms UI response for local development)
SENTINEL_DATABASE_URL=sqlite+pysqlite:///data/sentinel_local.sqlite3

# Cloud SQL PostgreSQL (Centralized Cloud Instance for Cloud Run & team sharing)
CLOUD_SQL_DATABASE_URL=postgresql+psycopg://sentinel:<password>@<cloud-sql-host>:5432/sentinel

# Automatically replicate local state changes to Cloud SQL asynchronously in background
ENABLE_CLOUD_SQL_SYNC=true

# Isolated identity authority. Sentinel accepts only OAuth/OIDC authentication.
AUTH_MODE=oidc
BETTER_AUTH_URL=http://127.0.0.1:8020
BETTER_AUTH_ISSUER=http://127.0.0.1:8020/api/auth
AUTH_DATABASE_URL=postgresql://sentinel_auth:<auth-db-password>@127.0.0.1:5434/sentinel_auth
BETTER_AUTH_SECRET=<generate-at-least-32-random-bytes>
OAUTH_TOKEN_ENCRYPTION_KEY=<generate-at-least-32-random-bytes>
OAUTH_AUDIENCE=http://127.0.0.1:8017/api
OAUTH_WEB_CLIENT_ID=sentinel-web
OAUTH_WEB_CLIENT_SECRET=<sentinel-web-client-secret>
OAUTH_CHAT_CLIENT_ID=sentinel-chat
OAUTH_CHAT_CLIENT_SECRET=<sentinel-chat-client-secret>
SENTINEL_PUBLIC_URL=http://127.0.0.1:8017
SENTINEL_WEB_URL=http://127.0.0.1:8017
AUTH_PORT=8020
AUTH_AUTO_MIGRATE=true

# Firebase customer identity bridge. Use only a configured Firebase test number locally.
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_WEB_API_KEY=<firebase-web-api-key>
FIREBASE_AUTH_DOMAIN=<firebase-project-id>.firebaseapp.com
AUTH_FIREBASE_TEST_PHONE=+919876543210
AUTH_FIREBASE_TEST_CODE=246810
AUTH_FIREBASE_IDENTITIES={"+919876543210":{"name":"Aarav Mehta","sentinelUserId":"USR-CUSTOMER-001"}}

# Demo staff bootstrap. Override in every deployed environment.
AUTH_STAFF_USERNAME=officer.mumbai
AUTH_STAFF_PASSWORD=<staff-bootstrap-password>
AUTH_STAFF_EMAIL=officer.mumbai@staff.sentinel.invalid

# Security & CORS
SENTINEL_COOKIE_SECURE=false
SENTINEL_ALLOWED_ORIGINS=http://127.0.0.1:8017,http://localhost:8017
SENTINEL_AUDIT_HMAC_KEY=<replace-with-a-managed-secret>

# Google Cloud & Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1
PORT=8017
